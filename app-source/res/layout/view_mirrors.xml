<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenMirrors"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_mirrors"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT4"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="顺序 = 测速顺序，同分时靠前优先"
                android:textColor="?attr/cText3"
                android:textSize="?attr/dT1" />
        </LinearLayout>

        <TextView
            android:id="@+id/mirrorCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="已启用 0 / 0"
            android:textColor="?attr/cChipText"
            android:textSize="?attr/dT1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mirrorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="说明" />

                <TextView
                    android:id="@+id/mirrorNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:text="逐个发 256 KB Range 请求，得分 = 速度 70% + 延迟 30%。多个文件可同时下载，共用这份排名；失败自动顺延到下一个镜像。"
                    android:textColor="?attr/cText2"
                    android:textSize="?attr/dT2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="候选列表"
                    android:textColor="?attr/cText"
                    android:textSize="?attr/dT3"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="按住 ≡ 拖动排序"
                    android:textColor="?attr/cText3"
                    android:textSize="?attr/dT1" />

                <TextView
                    android:id="@+id/btnRestoreMirrors"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ghost"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="恢复内置"
                    android:textColor="?attr/cText2"
                    android:textSize="?attr/dT1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mirrorPrefs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加自定义镜像"
                    android:textColor="?attr/cText"
                    android:textSize="?attr/dT3"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/customInput"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="https://你的镜像域名/"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="?attr/dT1"
                        android:textColor="?attr/cText"
                        android:textColorHint="?attr/cText3" />

                    <ImageView
                        android:id="@+id/btnAddMirror"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_primary"
                        android:padding="13dp"
                        android:src="@drawable/ic_add"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="添加镜像" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/addModePrefix"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:minWidth="94dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="拼完整链接"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />

                    <TextView
                        android:id="@+id/addModePath"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:minWidth="94dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="拼 GitHub 路径"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/customHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="拼完整链接：https://镜像域名/https://github.com/owner/repo/..."
                    android:textColor="?attr/cText3"
                    android:textSize="?attr/dT1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
