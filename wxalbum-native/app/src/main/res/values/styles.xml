    <!-- ============ 墨水屏 6 英寸专用（1072x1448 / 300dpi / 6.0"）============
         与普通「墨水屏」的区别：
         1) 1bit 黑白，零半透明零彩色，避免灰阶抖动与残影
         2) 字号整体再放大一档，适配 572dp 宽但物理只有 6 英寸的高密屏
         3) 纯黑 2dp 实线描边 + 近直角，减少圆角抗锯齿伪影
         4) 关闭窗口动画；选中态改用反白（黑底白字），不靠浅灰区分
         5) 运行时降低轮询频率并在空闲时跳过重绘（见 MainActivity）       -->
    <style name="AppTheme.Eink6" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF000000</item>
        <item name="android:colorPrimaryDark">#FFFFFFFF</item>
        <item name="android:colorAccent">#FF000000</item>
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 系统控件（CheckBox / 滚动条 / ripple）默认用灰，这里强制 1bit -->
        <item name="android:colorControlNormal">#FF000000</item>
        <item name="android:colorControlActivated">#FF000000</item>
        <item name="android:colorControlHighlight">#FFFFFFFF</item>
        <item name="android:alertDialogTheme">@style/EinkDialog</item>
        <item name="android:textColorPrimary">#FF000000</item>
