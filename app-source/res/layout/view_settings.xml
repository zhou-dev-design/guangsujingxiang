<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="?attr/cText"
            android:textSize="?attr/dT4"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="下载与测速策略"
            android:textColor="?attr/cText3"
            android:textSize="?attr/dT1" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 追踪格式（大范围）：内容在 MainActivity.buildFormatSection() 里铺 -->
            <LinearLayout
                android:id="@+id/fmtSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="显示"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示主题"
                        android:textColor="?attr/cText"
                        android:textSize="?attr/dT2" />

                    <TextView
                        android:id="@+id/themeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="深色 / 浅色 / 墨水屏黑白，按屏幕自动选"
                        android:textColor="?attr/cText3"
                        android:textSize="?attr/dT1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/themeAuto"
                        android:layout_width="0dp"
                        android:layout_height="?attr/dBtnH"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="自动"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />

                    <TextView
                        android:id="@+id/themeDark"
                        android:layout_width="0dp"
                        android:layout_height="?attr/dBtnH"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="深色"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />

                    <TextView
                        android:id="@+id/themeLight"
                        android:layout_width="0dp"
                        android:layout_height="?attr/dBtnH"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="浅色"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />

                    <TextView
                        android:id="@+id/themeMono"
                        android:layout_width="0dp"
                        android:layout_height="?attr/dBtnH"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="黑白"
                        android:textColor="?attr/cChipText"
                        android:textSize="?attr/dT1" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="下载"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:id="@+id/rowSavePath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="保存位置"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/savePathSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="应用私有目录，卸载后自动清理"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/savePath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="应用私有 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:id="@+id/rowConcurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="同时下载任务数"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/concSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="1~10 个，点这里直接输入数字"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/concValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="3 个 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="单文件多线程"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="切片并发拉取，镜像支持 Range 时生效"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swMulti"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:id="@+id/rowThreads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="每个文件连接数"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/threadsSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="1~10 段，点这里直接输入数字"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/threadsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="10 线程 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="失败自动换镜像"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="按测速排名顺延"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swFailover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowFailoverMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="最多重试几个镜像"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/failoverMaxSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="一个失败就换下一个"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/failoverMaxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="3 个 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="断点续传"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="镜像支持 Range 时生效"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swResume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="版本页"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="挑文件方式"
                    android:textColor="?attr/cText"
                    android:textSize="?attr/dT2"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/watchModeSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="点一个文件就直接测速下载"
                    android:textColor="?attr/cText3"
                    android:textSize="?attr/dT1" />

                <!-- 左右可点、也可按住拖过去；选中的一侧用主色块兜住 -->
                <com.lightmirror.dl.SegmentSlider
                    android:id="@+id/segWatchMode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:contentDescription="挑文件方式" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="测速"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:id="@+id/rowChunk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="探测分片"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="越大越准，也越费流量"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chunkValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="256 KB ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:id="@+id/rowTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="单个镜像超时"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="超时直接判负，不拖慢整体"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/timeoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="8 秒 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="复用测速结果"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/cacheSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="周期内的结果直接使用，不必每次重测"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:id="@+id/rowTtl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="复用周期"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="1~720 分钟，网络经常变就调短一点"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ttlValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="10 分钟 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="记录"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:id="@+id/rowHistoryMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="历史记录条数"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:id="@+id/historyMaxSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="列表最多显示 20 条，调小不会删掉记录"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/historyMaxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="20 条 ›"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="关于"
                android:textColor="?attr/cText"
                android:textSize="?attr/dT3"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="版本"
                        android:textColor="?attr/cText"
                        android:textSize="?attr/dT2" />

                    <TextView
                        android:id="@+id/appVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/cLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="支持的链接"
                            android:textColor="?attr/cText"
                            android:textSize="?attr/dT2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="release 附件 / archive / raw / 普通直链"
                            android:textColor="?attr/cText3"
                            android:textSize="?attr/dT1" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 类"
                        android:textColor="?attr/cText2"
                        android:textSize="?attr/dT2" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="光速镜像 · 只做链路选择\n不代理、不缓存任何内容"
                android:textColor="?attr/cText3"
                android:textSize="?attr/dT0" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
