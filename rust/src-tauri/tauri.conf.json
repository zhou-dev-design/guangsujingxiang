{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightMirror",
  "version": "3.0.0",
  "identifier": "com.lightmirror.dl",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "光速镜像",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "GitHub 镜像下载加速器",
    "longDescription": "光速镜像：只用国内镜像下载 GitHub 文件，逐个测速后只走最快链路；支持多任务并发、单文件多段并行、断点续传与版本追踪。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
