<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/cBg">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/view_home" />

        <include layout="@layout/view_history" />

        <include layout="@layout/view_watch" />

        <include layout="@layout/view_mirrors" />

        <include layout="@layout/view_settings" />
    </FrameLayout>

    <View
        android:id="@+id/dividerTab"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/cLine" />

    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="?attr/cTabBar">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icoHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_download"
                android:contentDescription="@string/tab_home" />

            <TextView
                android:id="@+id/lblHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_home"
                android:textSize="?attr/dTab"
                android:textStyle="bold"
                android:textColor="?attr/cPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabWatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icoWatch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_watch"
                android:contentDescription="@string/tab_watch" />

            <TextView
                android:id="@+id/lblWatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_watch"
                android:textSize="?attr/dTab"
                android:textStyle="bold"
                android:textColor="?attr/cText3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icoHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_history"
                android:contentDescription="@string/tab_history" />

            <TextView
                android:id="@+id/lblHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_history"
                android:textSize="?attr/dTab"
                android:textStyle="bold"
                android:textColor="?attr/cText3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMirror"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icoMirror"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_mirror"
                android:contentDescription="@string/tab_mirror" />

            <TextView
                android:id="@+id/lblMirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_mirror"
                android:textSize="?attr/dTab"
                android:textStyle="bold"
                android:textColor="?attr/cText3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icoSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_settings"
                android:contentDescription="@string/tab_settings" />

            <TextView
                android:id="@+id/lblSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_settings"
                android:textSize="?attr/dTab"
                android:textStyle="bold"
                android:textColor="?attr/cText3" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
